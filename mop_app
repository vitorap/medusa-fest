                     }\n                      ]\n                    }\n                  ]\n                }\n\n                Example:\n                {\n                  \"path/to/file.java\": [\n                    {\n                      \"robot_id\": \"linter-bot\",\n                      \"robot_run_id\": \"run-123\",\n                      \"message\": \"[nit] trailing whitespace\",\n                      \"line\": 23,\n                    },\n                    {\n                      \"robot_id\": \"formatter-bot\",\n                      \"robot_run_id\": \"run-456\",\n                      \"message\": \"Incorrect indentation\",\n                      \"range\": {\"start_line\": 50, \"start_character\": 0, \"end_line\": 55, \"end_character\": 20},\n                      \"fix_suggestions\": [\n                        {\n                          \"description\": \"Fix indentation to 4 spaces\",\n                          \"replacements\": [\n                            {\n                              \"path\": \"path/to/file.java\",\n                              \"range\": {\"start_line\": 50, \"start_character\": 0, \"end_line\": 55, \"end_character\": 20},\n                              \"replacement\": \"    properly indented code\"\n                            }\n                          ]\n                        }\n                      ]\n                    }\n                  ]\n                }\n\n        Robot Comment Fields (Gerrit 3.8.9 API):\n            - robot_id: (required) Identifier of the robot that generated the comment\n            - robot_run_id: (required) Identifier of the robot run that generated the comment\n            - message: (required) The comment message\n            - path: File path (automatically set from dict key)\n            - line: Line number for line comments\n            - range: Range for multi-line comments with start_line, start_character, end_line, end_character\n            - fix_suggestions: Array of FixSuggestionInfo objects\n\n        Examples:\n            # Simple approval\n            labels={\"Code-Review\": +2}\n\n            # Robot comments with fix suggestions\n            message=\"Automated code review completed\"\n            labels={\"Code-Review\": -1}\n            robot_comments={\n              \"src/main.py\": [\n                {\n                  \"robot_id\": \"code-analyzer\",\n                  \"robot_run_id\": \"analysis-2024-001\",\n                  \"message\": \"Fix typo in variable name\",\n                  \"line\": 42,\n                  \"fix_suggestions\": [\n                    {\n                      \"description\": \"Rename 'varialbe' to 'variable'\",\n                      \"replacements\": [\n                        {\n                          \"path\": \"src/main.py\",\n                          \"range\": {\"start_line\": 42, \"start_character\": 8, \"end_line\": 42, \"end_character\": 16},\n                          \"replacement\": \"variable\"\n                        }\n                      ]\n                    }\n                  ]\n                }\n              ]\n            }\n\n        Comments Fields (Gerrit 3.8.9 API):\n            - message: (required) The comment message\n            - line: Line number for line comments\n            - range: Range for multi-line comments with start_line, start_character, end_line, end_character\n            - unresolved: Mark comment as unresolved (requires attention)\n\n        Comments Schema: Dict[str, List[CommentInfo]] where:\n        - Key: file path (string)\n        - Value: List of CommentInfo objects\n\n        CommentInfo schema:\n        {\n          \"message\": str,            # Required: Comment message\n          \"line\": int,               # Optional: Line number for line comments\n          \"range\": {                 # Optional: Range for multi-line comments\n            \"start_line\": int,\n            \"start_character\": int,\n            \"end_line\": int,\n            \"end_character\": int\n          },\n          \"unresolved\": bool         # Optional: Mark comment as unresolved\n        }\n\n        Example:\n        {\n          \"path/to/file.java\": [\n            {\n              \"message\": \"This needs to be refactored\",\n              \"line\": 23,\n              \"unresolved\": true\n            },\n            {\n              \"message\": \"Consider using a more descriptive variable name\",\n              \"range\": {\"start_line\": 50, \"start_character\": 0, \"end_line\": 55, \"end_character\": 20}\n            }\n          ]\n        }\n        ",
          "input_schema": {
