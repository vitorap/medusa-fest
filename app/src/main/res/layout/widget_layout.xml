<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F0050805"
    android:padding="12dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MEDUSA FEST · CULLERA 2026"
        android:textColor="#FFD36A"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="6dp"/>
    <TextView android:id="@+id/wRage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFD36A"
        android:textSize="11sp"
        android:layout_marginBottom="4dp"/>
    <TextView android:id="@+id/wKodama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFC247"
        android:textSize="11sp"
        android:layout_marginBottom="4dp"/>
    <TextView android:id="@+id/wTortuga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF7EB6"
        android:textSize="11sp"/>
</LinearLayout>
