<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MASTERS OF PUPPETS"
        android:textColor="#bb86fc"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:gravity="center"
        android:layout_marginBottom="4dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BRASIL 2026"
        android:textColor="#9e9e9e"
        android:textSize="12sp"
        android:letterSpacing="0.3"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <Button android:id="@+id/btnLineup"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:text="FULL LINEUP"
        android:textSize="12sp"
        android:letterSpacing="0.1"
        android:backgroundTint="#1a1a2e"
        android:textColor="#bb86fc"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="32dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_rage"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <TextView android:id="@+id/tvRage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#ff6b6b"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_kodama"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <TextView android:id="@+id/tvKodama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#69f0ae"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_tortuga"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <TextView android:id="@+id/tvTortuga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#ffd740"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
