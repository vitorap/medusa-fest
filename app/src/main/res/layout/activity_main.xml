<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d0d1a"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="Master Of Puppets Brasil 2026"
        android:scaleType="fitCenter"
        android:src="@drawable/home_header"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <Button android:id="@+id/btnLineup"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="FULL LINEUP"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:backgroundTint="#1a1a2e"
            android:textColor="#bb86fc"/>
        <Button android:id="@+id/btnFavorites"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="FAVORITES"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:backgroundTint="#1a1a2e"
            android:textColor="#bb86fc"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="32dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="184dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#1a0a0a"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#44ff4444"
                app:strokeWidth="1dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/stage_rage"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/home_stage_scrim"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="116dp"
                        android:paddingBottom="14dp">
                        <TextView android:id="@+id/tvRage"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:textColor="#ff8f8f"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"
                            android:shadowColor="#E6000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="3"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/favRage"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:gravity="center"
                                android:textColor="#bb86fc"
                                android:textSize="20sp"/>
                            <LinearLayout
                                android:id="@+id/linksRage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical"/>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="184dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#0a1a0f"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#4400e676"
                app:strokeWidth="1dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/stage_kodama"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/home_stage_scrim"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="116dp"
                        android:paddingBottom="14dp">
                        <TextView android:id="@+id/tvKodama"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:textColor="#8dffc4"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"
                            android:shadowColor="#E6000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="3"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/favKodama"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:gravity="center"
                                android:textColor="#bb86fc"
                                android:textSize="20sp"/>
                            <LinearLayout
                                android:id="@+id/linksKodama"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical"/>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="184dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#1a150a"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#44ffab00"
                app:strokeWidth="1dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/stage_tortuga"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/home_stage_scrim"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="116dp"
                        android:paddingBottom="14dp">
                        <TextView android:id="@+id/tvTortuga"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:textColor="#ffe27a"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"
                            android:shadowColor="#E6000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="3"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/favTortuga"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:gravity="center"
                                android:textColor="#bb86fc"
                                android:textSize="20sp"/>
                            <LinearLayout
                                android:id="@+id/linksTortuga"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical"/>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
