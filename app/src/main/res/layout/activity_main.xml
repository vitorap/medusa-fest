<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.82"
        android:contentDescription="Master Of Puppets Brasil 2026"
        android:scaleType="fitCenter"
        android:src="@drawable/home_header"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button android:id="@+id/btnLineup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="LINEUP"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0"
            android:backgroundTint="#101018"
            android:textColor="#bb86fc"/>
        <Button android:id="@+id/btnFavorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="FAVORITES"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0"
            android:backgroundTint="#101018"
            android:textColor="#bb86fc"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.2"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#44ff4444"
            app:strokeWidth="1dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/stage_rage"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/home_stage_scrim"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="112dp"
                    android:paddingBottom="10dp">
                    <TextView android:id="@+id/tvRage"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:includeFontPadding="false"
                        android:textColor="#ff9a9a"
                        android:textSize="12.5sp"
                        android:maxLines="5"
                        android:ellipsize="end"
                        android:lineSpacingExtra="2dp"
                        android:shadowColor="#F0000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="10sp"
                        app:autoSizeMaxTextSize="12.5sp"
                        app:autoSizeStepGranularity="0.5sp"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/favRage"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:textColor="#bb86fc"
                            android:textSize="18sp"/>
                        <LinearLayout
                            android:id="@+id/linksRage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#4400e676"
            app:strokeWidth="1dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/stage_kodama"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/home_stage_scrim"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="112dp"
                    android:paddingBottom="10dp">
                    <TextView android:id="@+id/tvKodama"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:includeFontPadding="false"
                        android:textColor="#98ffd0"
                        android:textSize="12.5sp"
                        android:maxLines="5"
                        android:ellipsize="end"
                        android:lineSpacingExtra="2dp"
                        android:shadowColor="#F0000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="10sp"
                        app:autoSizeMaxTextSize="12.5sp"
                        app:autoSizeStepGranularity="0.5sp"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/favKodama"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:textColor="#bb86fc"
                            android:textSize="18sp"/>
                        <LinearLayout
                            android:id="@+id/linksKodama"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#44ffab00"
            app:strokeWidth="1dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/stage_tortuga"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/home_stage_scrim"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="112dp"
                    android:paddingBottom="10dp">
                    <TextView android:id="@+id/tvTortuga"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:includeFontPadding="false"
                        android:textColor="#ffe58a"
                        android:textSize="12.5sp"
                        android:maxLines="5"
                        android:ellipsize="end"
                        android:lineSpacingExtra="2dp"
                        android:shadowColor="#F0000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="10sp"
                        app:autoSizeMaxTextSize="12.5sp"
                        app:autoSizeStepGranularity="0.5sp"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/favTortuga"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:textColor="#bb86fc"
                            android:textSize="18sp"/>
                        <LinearLayout
                            android:id="@+id/linksTortuga"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
